{
  "parser_id": "core_aws_vpc_v1",
  "parser_version": "1.0.0",
  "description": "NETWORK",
  "regex_pattern": "(?i)^\\d+\\s+\\d+\\s+eni-[a-z0-9]+\\s+(?P<src_ip>\\d+\\.\\d+\\.\\d+\\.\\d+)\\s+(?P<dst_ip>\\d+\\.\\d+\\.\\d+\\.\\d+)\\s+\\d+\\s+\\d+\\s+(?P<proto>\\d+)\\s+\\d+\\s+\\d+\\s+\\d+\\s+\\d+\\s+(?P<action>ACCEPT|REJECT)\\s+(?P<status>OK|NODATA|SKIPDATA)",
  "field_mappings": {
    "src_ip": "src_ip",
    "dst_ip": "dst_ip",
    "proto": "proto",
    "action": "action"
  }
